{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QMT IPO configuration",
  "type": "object",
  "required": [
    "account_id",
    "qmt_userdata",
    "state_dir",
    "control_dir",
    "webhook_file",
    "allowed_markets",
    "enable_execution"
  ],
  "properties": {
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "qmt_userdata": {
      "type": "string",
      "minLength": 1
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "control_dir": {
      "type": "string",
      "minLength": 1
    },
    "webhook_file": {
      "type": "string",
      "minLength": 1
    },
    "allowed_markets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SH",
          "SZ",
          "KCB"
        ]
      }
    },
    "enable_execution": {
      "type": "boolean",
      "default": false
    },
    "receipt_hot_days": {
      "type": "integer",
      "minimum": 7,
      "maximum": 366
    },
    "backup_keep": {
      "type": "integer",
      "minimum": 2,
      "maximum": 365
    },
    "archive_warn_mb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "calendar_dir": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Documentation schema. runtime.validate_config additionally enforces absolute paths and local recovery guards. Secrets are never stored directly in this JSON."
}
